# Public tile URL, never put private API keys in NEXT_PUBLIC_* values.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Mutation routes for fake data only run in development, unless explicitly enabled.
# Keep unset for a public production deployment.
HOMIE_ENABLE_DEMO_MUTATIONS=false
